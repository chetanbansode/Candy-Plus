<ui:FluentWindow x:Class="YtDlpGui.Views.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:vm="clr-namespace:YtDlpGui.ViewModels"
                 xmlns:cv="clr-namespace:YtDlpGui.Converters"
                 mc:Ignorable="d"
                 Width="640" Height="650"
                 MinWidth="640" MinHeight="650"
                 ResizeMode="CanResize"
                 WindowStartupLocation="CenterScreen"
                 ExtendsContentIntoTitleBar="True"
                 Title="{Binding AppName, Mode=OneWay}"
                 xmlns:local="clr-namespace:YtDlpGui">

    <Window.Resources>
        <cv:BoolToVisibilityConverter x:Key="BoolToVis"/>
        <cv:WidthToHeaderConverter x:Key="WidthToHeader"/>
        <cv:StringToVisibilityConverter x:Key="StringToVis"/>

        <Style x:Key="ToggleListStyle" TargetType="ListBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="ItemsPanel">
                <Setter.Value>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Margin" Value="0,0,8,8"/>
                        <Setter Property="Padding" Value="16,10"/>
                        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="Bd" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="4" Padding="{TemplateBinding Padding}" Background="Transparent">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SystemAccentColorPrimaryBrush}"/>
                                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource SystemAccentColorPrimaryBrush}"/>
                                            <Setter Property="Foreground" Value="White"/>
                                        </Trigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="UniformToggleListStyle" TargetType="ListBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="ItemsPanel">
                <Setter.Value>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="5"/>
                    </ItemsPanelTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Margin" Value="0,0,6,6"/>
                        <Setter Property="Padding" Value="4,8"/>
                        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
                        <Setter Property="HorizontalContentAlignment" Value="Center"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="Bd" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="4" Padding="{TemplateBinding Padding}" Background="Transparent">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SystemAccentColorPrimaryBrush}"/>
                                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource SystemAccentColorPrimaryBrush}"/>
                                            <Setter Property="Foreground" Value="White"/>
                                        </Trigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <ui:TitleBar Grid.Row="0" ShowMaximize="True">
            <ui:TitleBar.Header>
                <TextBlock Text="{Binding AppName, Mode=OneWay}" ToolTip="{Binding AppVersion, StringFormat=v{0}, Mode=OneWay}" WindowChrome.IsHitTestVisibleInChrome="True" VerticalAlignment="Center" Margin="0,0,0,0" FontSize="12" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
            </ui:TitleBar.Header>
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="pack://application:,,,/icons/universal.png" RenderTransformOrigin="0.5,0.5">
                    <ui:ImageIcon.RenderTransform>
                        <ScaleTransform ScaleX="1.5" ScaleY="1.5" />
                    </ui:ImageIcon.RenderTransform>
                </ui:ImageIcon>
            </ui:TitleBar.Icon>
        </ui:TitleBar>
        
        <Grid Grid.Row="1" Margin="24,8,24,24">
            
            <!-- HOME PAGE -->
            <Grid Visibility="{Binding IsHomePage, Converter={StaticResource BoolToVis}}">
                <Button Command="{Binding OpenSettingsCommand}" Content="⚙ Preferences" HorizontalAlignment="Right" VerticalAlignment="Top" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="What do you want to download today?" FontSize="26" Foreground="{DynamicResource TextFillColorPrimaryBrush}" HorizontalAlignment="Center" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <TextBlock Text="Select an option to get started" FontSize="16" Foreground="{DynamicResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" Margin="0,0,0,32"/>
                    
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button Command="{Binding NavigateToAudioCommand}" Width="130" Height="80" Margin="0,0,16,0" Style="{DynamicResource AccentButtonStyle}">
                            <StackPanel>
                                <TextBlock Text="🎵" FontSize="28" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                                <TextBlock Text="Audio" HorizontalAlignment="Center" FontWeight="Medium"/>
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding NavigateToVideoCommand}" Width="130" Height="80" Margin="0,0,16,0" Style="{DynamicResource AccentButtonStyle}">
                            <StackPanel>
                                <TextBlock Text="🎬" FontSize="28" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                                <TextBlock Text="Video" HorizontalAlignment="Center" FontWeight="Medium"/>
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding NavigateToManualCommand}" Visibility="{Binding IsPlusVersion, Converter={StaticResource BoolToVis}}" Width="130" Height="80">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsPlusVersion}" Value="False">
                                            <Setter Property="ToolTip" Value="Available in Candy Plus"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsPlusVersion}" Value="True">
                                            <Setter Property="ToolTip" Value="{x:Null}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <StackPanel>
                                <TextBlock Text="⚙" FontSize="28" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                                <TextBlock Text="Manual" HorizontalAlignment="Center" FontWeight="Medium"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Grid>
            
            <!-- URL INPUT PAGE -->
            <Grid Visibility="{Binding IsUrlInputPage, Converter={StaticResource BoolToVis}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <ui:Button Grid.Row="0" Command="{Binding GoBackCommand}" Content="← Back" HorizontalAlignment="Left" Appearance="Transparent" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="-8,0,0,16"/>
                
                <TextBlock Grid.Row="1" Text="Enter YouTube URL" FontSize="18" Foreground="{DynamicResource TextFillColorPrimaryBrush}" FontWeight="SemiBold" Margin="0,0,0,4"/>
                <TextBlock Grid.Row="2" Text="{Binding UrlInputSubtitle}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,16"/>
                
                <StackPanel Grid.Row="3">
                    <ui:TextBox Text="{Binding VideoUrl, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="https://youtube.com/watch?v=..." FontSize="16" Padding="12"/>
                    <TextBlock Text="✓ Pasted from clipboard" Foreground="#4CAF50" Margin="4,4,0,0" Visibility="{Binding IsUrlFromClipboard, Converter={StaticResource BoolToVis}}"/>
                    
                    <TextBlock Text="{Binding ErrorMessage}" Foreground="Red" Margin="4,16,0,0" TextWrapping="Wrap">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ErrorMessage}" Value="">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
                
                <Button Grid.Row="4" Command="{Binding FetchFormatsCommand}" Content="Next →" HorizontalAlignment="Right" Style="{DynamicResource AccentButtonStyle}" Padding="24,8"/>
            </Grid>

            <!-- PROCESSING PAGE -->
            <StackPanel Visibility="{Binding IsProcessingPage, Converter={StaticResource BoolToVis}}" VerticalAlignment="Center">
                <ui:ProgressRing IsIndeterminate="True" Width="64" Height="64" HorizontalAlignment="Center" Margin="0,0,0,16"/>
                <TextBlock Text="{Binding ProcessingText}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center"/>
            </StackPanel>

            <!-- AUDIO OPTIONS PAGE -->
            <Grid Visibility="{Binding IsAudioOptionsPage, Converter={StaticResource BoolToVis}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <ui:Button Grid.Row="0" Command="{Binding GoBackCommand}" Content="← Back" HorizontalAlignment="Left" Appearance="Transparent" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="-8,0,0,16"/>
                
                <TextBlock Grid.Row="1" Text="Select Audio Format" FontSize="18" Foreground="{DynamicResource TextFillColorPrimaryBrush}" FontWeight="SemiBold" Margin="0,0,0,16"/>
                
                <ScrollViewer x:Name="AudioOptionsScrollViewer" Grid.Row="2" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <!-- Codecs -->
                        <ListBox ItemsSource="{Binding AvailableCodecs}" SelectedItem="{Binding SelectedCodec}" Style="{StaticResource ToggleListStyle}" Margin="0,0,0,8"/>
                        
                        <!-- Qualities -->
                        <ListBox ItemsSource="{Binding AvailableQualities}" SelectedItem="{Binding SelectedFormat}" Style="{StaticResource ToggleListStyle}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="★ " Visibility="{Binding IsRecommended, Converter={StaticResource BoolToVis}}"/>
                                        <TextBlock Text="{Binding QualityLabel}"/>
                                        <TextBlock Text=" · "/>
                                        <TextBlock Text="{Binding Bitrate, StringFormat={}{0:0}kbps}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <TextBlock Text="{Binding RecommendationText}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12" Margin="4,4,0,24"/>
                        
                        <!-- Save Path -->
                        <TextBlock Text="Save to" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,0,0,4"/>
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ui:TextBox Grid.Column="0" Text="{Binding SavePath}" IsReadOnly="True" Margin="0,0,8,0"/>
                            <Button Grid.Column="1" Command="{Binding BrowseSavePathCommand}" Content="Browse" Padding="16,6"/>
                        </Grid>
                        
                        <CheckBox Content="Open folder after download" IsChecked="{Binding OpenFolderAfterDownload}" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,0,0,24"/>
                    </StackPanel>
                </ScrollViewer>
                
                <StackPanel Grid.Row="4" Margin="0,0,0,10">
                    <TextBlock Text="{Binding ExpectedFileSizeLabel}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12" Margin="0,0,0,8" HorizontalAlignment="Center" Visibility="{Binding ExpectedFileSizeLabel, Converter={StaticResource StringToVis}}"/>
                    <Button Command="{Binding StartDownloadCommand}" Content="Start Download" HorizontalAlignment="Stretch" Style="{DynamicResource AccentButtonStyle}" Padding="0,10"/>
                </StackPanel>
            </Grid>

            <!-- VIDEO OPTIONS PAGE -->
            <Grid Visibility="{Binding IsVideoOptionsPage, Converter={StaticResource BoolToVis}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <ui:Button Grid.Row="0" Command="{Binding GoBackCommand}" Content="← Back" HorizontalAlignment="Left" Appearance="Transparent" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="-8,0,0,8"/>
                
                <TextBlock Grid.Row="1" Text="Select Video Format" FontSize="18" Foreground="{DynamicResource TextFillColorPrimaryBrush}" FontWeight="SemiBold" Margin="0,0,0,12"/>
                
                <ScrollViewer x:Name="VideoOptionsScrollViewer" Grid.Row="2" VerticalScrollBarVisibility="Auto" Margin="0,0,0,8">
                    <StackPanel>
                        <!-- Resolution -->
                        <TextBlock Text="Resolution" Foreground="{DynamicResource TextFillColorPrimaryBrush}" FontWeight="Medium" Margin="0,0,0,6"/>
                        <ListBox ItemsSource="{Binding AvailableResolutions}" SelectedItem="{Binding SelectedResolution}" Style="{StaticResource UniformToggleListStyle}" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled" Margin="0,0,0,10"/>
                        
                        <!-- Frame Rate / Container / Audio Quality -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,24,0">
                                <TextBlock Text="Frame Rate" Foreground="{DynamicResource TextFillColorPrimaryBrush}" FontWeight="Medium" Margin="0,0,0,6"/>
                                <ListBox ItemsSource="{Binding AvailableFrameRates}" SelectedItem="{Binding SelectedFrameRate}" Style="{StaticResource ToggleListStyle}" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="0,0,24,0">
                                <TextBlock Text="Container" Foreground="{DynamicResource TextFillColorPrimaryBrush}" FontWeight="Medium" Margin="0,0,0,6"/>
                                <ListBox ItemsSource="{Binding ContainerOptions}" SelectedItem="{Binding SelectedContainer}" Style="{StaticResource ToggleListStyle}" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <TextBlock Text="Audio" Foreground="{DynamicResource TextFillColorPrimaryBrush}" FontWeight="Medium"/>
                                    <TextBlock Text=" (Fixed by default)" FontSize="10" Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Bottom" Margin="2,0,0,1"/>
                                </StackPanel>
                                <Border BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="4" Padding="16,10" HorizontalAlignment="Left">
                                    <TextBlock Text="{Binding AudioQualityDisplay}" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                </Border>
                            </StackPanel>
                        </Grid>
                        
                        <!-- Save Path -->
                        <TextBlock Text="Save to" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,0,0,4"/>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ui:TextBox Grid.Column="0" Text="{Binding SavePath}" IsReadOnly="True" Margin="0,0,8,0"/>
                            <Button Grid.Column="1" Command="{Binding BrowseSavePathCommand}" Content="Browse" Padding="16,6"/>
                        </Grid>
                        
                        <CheckBox Content="Open folder after download" IsChecked="{Binding OpenFolderAfterDownload}" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,0,0,8"/>
                    </StackPanel>
                </ScrollViewer>
                
                <StackPanel Grid.Row="3" Margin="0,0,0,10">
                    <TextBlock Text="{Binding ExpectedFileSizeLabel}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12" Margin="0,0,0,8" HorizontalAlignment="Center" Visibility="{Binding ExpectedFileSizeLabel, Converter={StaticResource StringToVis}}"/>
                    <Button Command="{Binding StartDownloadCommand}" Content="Start Download" HorizontalAlignment="Stretch" Style="{DynamicResource AccentButtonStyle}" Padding="0,10"/>
                </StackPanel>
            </Grid>

            <!-- MANUAL OPTIONS PAGE (Candy Plus) -->
            <Grid Visibility="{Binding IsManualOptionsPage, Converter={StaticResource BoolToVis}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <ui:Button Grid.Row="0" Command="{Binding GoBackCommand}" Content="← Back" HorizontalAlignment="Left" Appearance="Transparent" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="-8,0,0,8"/>

                <Grid Grid.Row="1" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    
                    <StackPanel Orientation="Horizontal" Visibility="{Binding IsPlusVersion, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="Mode:" Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <ui:ToggleSwitch Content="Remux (Combine Video + Audio)" IsChecked="{Binding IsRemuxerEnabled}" VerticalAlignment="Center"/>
                    </StackPanel>
                    
                    <ComboBox Grid.Column="1" ItemsSource="{Binding ManualFilterOptions}" SelectedItem="{Binding ManualFormatFilter}" HorizontalAlignment="Right" Width="130">
                        <ComboBox.Style>
                            <Style TargetType="ComboBox" BasedOn="{StaticResource DefaultComboBoxStyle}">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsRemuxerEnabled}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ComboBox.Style>
                    </ComboBox>
                </Grid>

                <ScrollViewer x:Name="ManualOptionsScrollViewer" Grid.Row="2" VerticalScrollBarVisibility="Auto" Margin="0,0,0,8">
                    <StackPanel Margin="0,0,14,0">
                        <ListView x:Name="FormatListView" SelectionMode="Single" SizeChanged="FormatListView_SizeChanged" ItemsSource="{Binding ManualFormats}" SelectedItem="{Binding SelectedManualFormat}" Background="Transparent" BorderThickness="0" MaxHeight="250" FontFamily="Consolas" FontSize="11.5" Foreground="{DynamicResource TextFillColorPrimaryBrush}" HorizontalAlignment="Stretch">
                            <ListView.Style>
                                <Style TargetType="ListView">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsRemuxerEnabled}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ListView.Style>
                            <ListView.ItemContainerStyle>
                                <Style TargetType="{x:Type ListViewItem}">
                                    <Setter Property="Padding" Value="4,4"/>
                                    <Setter Property="Margin" Value="0,0,0,2"/>
                                    <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Foreground" Value="Black"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter Property="Foreground" Value="Black"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="ID" DisplayMemberBinding="{Binding FormatId}" Width="45" />
                                    <GridViewColumn DisplayMemberBinding="{Binding Extension}" Width="65">
                                        <GridViewColumn.Header>
                                            <TextBlock Text="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=WindowState, Converter={StaticResource WidthToHeader}, ConverterParameter='Ext|Container'}"/>
                                        </GridViewColumn.Header>
                                    </GridViewColumn>
                                    <GridViewColumn DisplayMemberBinding="{Binding Resolution}" Width="75">
                                        <GridViewColumn.Header>
                                            <TextBlock Text="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=WindowState, Converter={StaticResource WidthToHeader}, ConverterParameter='Res|Resolution'}"/>
                                        </GridViewColumn.Header>
                                    </GridViewColumn>
                                    
                                        <GridViewColumn DisplayMemberBinding="{Binding Fps}" Width="70"><GridViewColumn.Header><TextBlock Text="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=WindowState, Converter={StaticResource WidthToHeader}, ConverterParameter='FPS|Frame Rate'}"/></GridViewColumn.Header></GridViewColumn>
                                    <GridViewColumn Header="Codec" DisplayMemberBinding="{Binding Codec}" Width="110" />
                                    <GridViewColumn Header="Bitrate" Width="75">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock>
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Text" Value="{Binding Bitrate, StringFormat={}{0:0}k}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Bitrate}" Value="0">
                                                                    <Setter Property="Text" Value=""/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn Header="Size" DisplayMemberBinding="{Binding FileSize}" Width="70" />
                                </GridView>
                            </ListView.View>
                        </ListView>

                        <Grid Visibility="{Binding IsRemuxerEnabled, Converter={StaticResource BoolToVis}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Grid Grid.Column="0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <TextBlock Text="Video Track:" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,0,0,4"/>
                                <ListView Grid.Row="1" x:Name="VideoFormatListView" SelectionMode="Single" SizeChanged="FormatListView_SizeChanged" ItemsSource="{Binding VideoFormats}" SelectedItem="{Binding SelectedVideoFormat}" Background="Transparent" BorderThickness="0" MaxHeight="250" FontFamily="Consolas" FontSize="11.5" Foreground="{DynamicResource TextFillColorPrimaryBrush}" HorizontalAlignment="Stretch" Margin="0,0,0,8">
                                    <ListView.ItemContainerStyle>
                                        <Style TargetType="{x:Type ListViewItem}">
                                            <Setter Property="Padding" Value="4,4"/>
                                            <Setter Property="Margin" Value="0,0,0,2"/>
                                            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Foreground" Value="Black"/>
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter Property="Foreground" Value="Black"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ListView.ItemContainerStyle>
                                    <ListView.View>
                                        <GridView>
                                            <GridViewColumn Header="ID" DisplayMemberBinding="{Binding FormatId}" Width="45" />
                                            <GridViewColumn DisplayMemberBinding="{Binding Extension}" Width="65">
                                                <GridViewColumn.Header>
                                                    <TextBlock Text="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=WindowState, Converter={StaticResource WidthToHeader}, ConverterParameter='Ext|Container'}"/>
                                                </GridViewColumn.Header>
                                            </GridViewColumn>
                                            <GridViewColumn DisplayMemberBinding="{Binding Resolution}" Width="75">
                                                <GridViewColumn.Header>
                                                    <TextBlock Text="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=WindowState, Converter={StaticResource WidthToHeader}, ConverterParameter='Res|Resolution'}"/>
                                                </GridViewColumn.Header>
                                            </GridViewColumn>
                                            
                                                <GridViewColumn DisplayMemberBinding="{Binding Fps}" Width="70"><GridViewColumn.Header><TextBlock Text="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=WindowState, Converter={StaticResource WidthToHeader}, ConverterParameter='FPS|Frame Rate'}"/></GridViewColumn.Header></GridViewColumn>
                                            <GridViewColumn Header="Codec" DisplayMemberBinding="{Binding Codec}" Width="110" />
                                            <GridViewColumn Header="Bitrate" Width="75">
                                                <GridViewColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <TextBlock>
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Text" Value="{Binding Bitrate, StringFormat={}{0:0}k}"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding Bitrate}" Value="0">
                                                                            <Setter Property="Text" Value=""/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </DataTemplate>
                                                </GridViewColumn.CellTemplate>
                                            </GridViewColumn>
                                            <GridViewColumn Header="Size" DisplayMemberBinding="{Binding FileSize}" Width="70" />
                                        </GridView>
                                    </ListView.View>
                                </ListView>
                            </Grid>

                            <Grid Grid.Column="2">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <TextBlock Text="Audio Track:" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,0,0,4"/>
                                <ListView Grid.Row="1" x:Name="AudioFormatListView" SelectionMode="Single" SizeChanged="FormatListView_SizeChanged" ItemsSource="{Binding AudioFormats}" SelectedItem="{Binding SelectedAudioFormat}" Background="Transparent" BorderThickness="0" MaxHeight="250" FontFamily="Consolas" FontSize="11.5" Foreground="{DynamicResource TextFillColorPrimaryBrush}" HorizontalAlignment="Stretch">
                                    <ListView.ItemContainerStyle>
                                        <Style TargetType="{x:Type ListViewItem}">
                                            <Setter Property="Padding" Value="4,4"/>
                                            <Setter Property="Margin" Value="0,0,0,2"/>
                                            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Foreground" Value="Black"/>
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter Property="Foreground" Value="Black"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ListView.ItemContainerStyle>
                                    <ListView.View>
                                        <GridView>
                                            <GridViewColumn Header="ID" DisplayMemberBinding="{Binding FormatId}" Width="45" />
                                            <GridViewColumn DisplayMemberBinding="{Binding Extension}" Width="75">
                                                <GridViewColumn.Header>
                                                    <TextBlock Text="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=WindowState, Converter={StaticResource WidthToHeader}, ConverterParameter='Ext|Container'}"/>
                                                </GridViewColumn.Header>
                                            </GridViewColumn>
                                            <GridViewColumn DisplayMemberBinding="{Binding Resolution}" Width="90">
                                                <GridViewColumn.Header>
                                                    <TextBlock Text="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=WindowState, Converter={StaticResource WidthToHeader}, ConverterParameter='Res|Resolution'}"/>
                                                </GridViewColumn.Header>
                                            </GridViewColumn>
                                            <GridViewColumn Header="Codec" DisplayMemberBinding="{Binding Codec}" Width="130" />
                                            <GridViewColumn Header="Bitrate" Width="85">
                                                <GridViewColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <TextBlock>
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Text" Value="{Binding Bitrate, StringFormat={}{0:0}k}"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding Bitrate}" Value="0">
                                                                            <Setter Property="Text" Value=""/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </DataTemplate>
                                                </GridViewColumn.CellTemplate>
                                            </GridViewColumn>
                                            <GridViewColumn Header="Size" DisplayMemberBinding="{Binding FileSize}" Width="85" />
                                        </GridView>
                                    </ListView.View>
                                </ListView>
                            </Grid>
                        </Grid>

                        <!-- Output Container -->
                        <Grid Margin="0,12,0,8" Visibility="{Binding IsRemuxerEnabled, Converter={StaticResource BoolToVis}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Merge into container" Foreground="{DynamicResource TextFillColorPrimaryBrush}" VerticalAlignment="Center"/>
                            <ComboBox Grid.Column="1" ItemsSource="{Binding RemuxContainers}" SelectedItem="{Binding SelectedRemuxContainer}" Width="80"/>
                        </Grid>

                        <!-- Per-download toggles -->
                        <Grid Margin="0,12,0,8">
                            <TextBlock Text="Use Cookies" Foreground="{DynamicResource TextFillColorPrimaryBrush}" VerticalAlignment="Center"/>
                            <ui:ToggleSwitch IsChecked="{Binding UseCookies}" HorizontalAlignment="Right"/>
                        </Grid>

                        <Grid Margin="0,0,0,8">
                            <TextBlock Text="Embed Creator Subtitles" Foreground="{DynamicResource TextFillColorPrimaryBrush}" VerticalAlignment="Center"/>
                            <ui:ToggleSwitch IsChecked="{Binding EmbedSubtitles}" HorizontalAlignment="Right"/>
                        </Grid>

                        <!-- Raw Arguments (only if enabled in settings) -->
                        <StackPanel Margin="0,0,0,8">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding AppSettings.EnableArgumentInjection}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <TextBlock Text="Custom Arguments" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,0,0,4"/>
                            <ui:TextBox Text="{Binding ManualArguments, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="e.g. --extract-audio --audio-format flac" FontFamily="Consolas" FontSize="12"/>
                        </StackPanel>

                        <!-- Save Path -->
                        <TextBlock Text="Save to" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,4,0,4"/>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ui:TextBox Grid.Column="0" Text="{Binding SavePath}" IsReadOnly="True" Margin="0,0,8,0"/>
                            <Button Grid.Column="1" Command="{Binding BrowseSavePathCommand}" Content="Browse" Padding="16,6"/>
                        </Grid>

                        <CheckBox Content="Open folder after download" IsChecked="{Binding OpenFolderAfterDownload}" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,0,0,8"/>
                    </StackPanel>
                </ScrollViewer>

                <StackPanel Grid.Row="4" Margin="0,0,0,10">
                    <TextBlock Text="{Binding ExpectedFileSizeLabel}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12" Margin="0,0,0,8" HorizontalAlignment="Center" Visibility="{Binding ExpectedFileSizeLabel, Converter={StaticResource StringToVis}}"/>
                    <Button Command="{Binding StartDownloadCommand}" Content="Start Download" HorizontalAlignment="Stretch" Style="{DynamicResource AccentButtonStyle}" Padding="0,10"/>
                </StackPanel>
            </Grid>

            <!-- DOWNLOADING PAGE -->
            <StackPanel Visibility="{Binding IsDownloadingPage, Converter={StaticResource BoolToVis}}" VerticalAlignment="Center">
                <TextBlock Text="{Binding StatusMessage, FallbackValue='Downloading...'}" FontSize="18" Foreground="{DynamicResource TextFillColorPrimaryBrush}" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,0,0,24"/>
                
                <ProgressBar Value="{Binding ProgressPercentage}" Maximum="100" Height="12" Margin="0,0,0,8"/>
                
                <Grid Margin="0,0,0,16">
                    <TextBlock Text="{Binding ProgressPercentage, StringFormat={}{0:0}%}" HorizontalAlignment="Left" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                    <TextBlock Text="{Binding ProgressSpeed}" HorizontalAlignment="Right" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                </Grid>
                
                <Grid Margin="0,0,0,32">
                    <TextBlock HorizontalAlignment="Left" Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                        <Run Text="Elapsed: "/>
                        <Run Text="{Binding ElapsedTime}"/>
                    </TextBlock>
                    <TextBlock HorizontalAlignment="Right" Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                        <Run Text="ETA: "/>
                        <Run Text="{Binding ProgressEta}"/>
                    </TextBlock>
                </Grid>
                
                <Button Command="{Binding CancelDownloadCommand}" Content="Cancel" HorizontalAlignment="Center" Background="Transparent" BorderThickness="1" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Padding="24,6"/>
            </StackPanel>

            <!-- COMPLETE PAGE -->
            <StackPanel Visibility="{Binding IsCompletePage, Converter={StaticResource BoolToVis}}" VerticalAlignment="Center">
                <TextBlock Text="✓" FontSize="48" Foreground="#4CAF50" HorizontalAlignment="Center" Margin="0,0,0,16"/>
                <TextBlock Text="Download Complete!" FontSize="18" Foreground="{DynamicResource TextFillColorPrimaryBrush}" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                <TextBlock Text="{Binding StatusMessage}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" Margin="0,0,0,32"/>
                
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button Command="{Binding GoHomeCommand}" Content="🏠 Home" Margin="0,0,16,0" Padding="16,8"/>
                    <Button Command="{Binding DownloadAnotherCommand}" Content="🔄 Download Another" Style="{DynamicResource AccentButtonStyle}" Padding="16,8"/>
                </StackPanel>
            </StackPanel>

            <!-- SETTINGS PAGE -->
            <Grid Visibility="{Binding IsSettingsPage, Converter={StaticResource BoolToVis}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <ui:Button Grid.Row="0" Command="{Binding GoBackCommand}" Content="← Back" HorizontalAlignment="Left" Appearance="Transparent" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="-8,0,0,16"/>

                <TextBlock Grid.Row="1" Text="Preferences" FontSize="24" Foreground="{DynamicResource TextFillColorPrimaryBrush}" FontWeight="SemiBold" Margin="0,0,0,24"/>
                
                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="140"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    
                    <ListBox Grid.Column="0" ItemsSource="{Binding SettingsCategories}" SelectedItem="{Binding SelectedSettingsCategory}" Margin="0,0,16,0" Background="Transparent" BorderThickness="0">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                <Setter Property="Padding" Value="12,8"/>
                                <Setter Property="Margin" Value="0,0,0,4"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
                            </Style>
                        </ListBox.ItemContainerStyle>
                    </ListBox>

                    <Rectangle Grid.Column="1" Width="1" Fill="{DynamicResource ControlStrokeColorDefaultBrush}" Margin="0,0,24,0" />

                    <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                        <Grid Margin="16,0,48,0">
                            <!-- Appearance -->
                            <StackPanel>
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedSettingsCategory}" Value="Appearance">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <Grid Margin="0,0,0,16">
                                    <TextBlock Text="Theme" Foreground="{DynamicResource TextFillColorPrimaryBrush}" VerticalAlignment="Center"/>
                                    <ComboBox ItemsSource="{Binding ThemeOptions}" SelectedItem="{Binding AppSettings.Theme}" HorizontalAlignment="Right" Width="120"/>
                                </Grid>
                            </StackPanel>

                            <!-- Downloads -->
                            <StackPanel>
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedSettingsCategory}" Value="Downloads">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <StackPanel Margin="0,0,0,16">
                                    <TextBlock Text="Default Audio Path" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                    <Grid Margin="0,8,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <ui:TextBox Grid.Column="0" Text="{Binding AppSettings.DefaultAudioPath}" IsReadOnly="True" Margin="0,0,8,0"/>
                                        <Button Grid.Column="1" Command="{Binding BrowseDefaultAudioPathCommand}" Content="Browse" Padding="16,6"/>
                                    </Grid>
                                </StackPanel>
                                <StackPanel Margin="0,0,0,24">
                                    <TextBlock Text="Default Video Path" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                    <Grid Margin="0,8,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <ui:TextBox Grid.Column="0" Text="{Binding AppSettings.DefaultVideoPath}" IsReadOnly="True" Margin="0,0,8,0"/>
                                        <Button Grid.Column="1" Command="{Binding BrowseDefaultVideoPathCommand}" Content="Browse" Padding="16,6"/>
                                    </Grid>
                                </StackPanel>
                                <Grid Margin="0,0,0,16">
                                    <TextBlock Text="If file already exists" Foreground="{DynamicResource TextFillColorPrimaryBrush}" VerticalAlignment="Center"/>
                                    <ComboBox ItemsSource="{Binding FileExistsOptions}" SelectedItem="{Binding AppSettings.FileExistsAction}" HorizontalAlignment="Right" Width="150"/>
                                </Grid>
                            </StackPanel>

                            <!-- Audio -->
                            <StackPanel>
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedSettingsCategory}" Value="Audio">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <Grid Margin="0,0,0,4">
                                    <TextBlock Text="Audio Conversion" Foreground="{DynamicResource TextFillColorPrimaryBrush}" VerticalAlignment="Center"/>
                                    <ComboBox ItemsSource="{Binding AudioConversionOptions}" SelectedItem="{Binding AppSettings.AudioConversion}" HorizontalAlignment="Right" Width="120"/>
                                </Grid>
                                <TextBlock Text="Warning: Converting from Native to MP3 may cause minor quality loss." Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12" Margin="0,0,0,24" TextWrapping="Wrap"/>
                                <Grid Margin="0,0,0,16">
                                    <TextBlock Text="Embed Thumbnail" Foreground="{DynamicResource TextFillColorPrimaryBrush}" VerticalAlignment="Center"/>
                                    <ui:ToggleSwitch IsChecked="{Binding AppSettings.EmbedThumbnail}" HorizontalAlignment="Right"/>
                                </Grid>
                                <Grid Margin="0,0,0,16">
                                    <TextBlock Text="Embed Metadata" Foreground="{DynamicResource TextFillColorPrimaryBrush}" VerticalAlignment="Center"/>
                                    <ui:ToggleSwitch IsChecked="{Binding AppSettings.EmbedMetadata}" HorizontalAlignment="Right"/>
                                </Grid>
                            </StackPanel>

                            <!-- Network -->
                            <StackPanel>
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedSettingsCategory}" Value="Network">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <Grid Margin="0,0,0,24">
                                    <TextBlock Text="Speed Limit" Foreground="{DynamicResource TextFillColorPrimaryBrush}" VerticalAlignment="Center"/>
                                    <ComboBox ItemsSource="{Binding SpeedLimitOptions}" SelectedItem="{Binding AppSettings.SpeedLimit}" HorizontalAlignment="Right" Width="120"/>
                                </Grid>
                                <StackPanel Margin="0,0,0,16" Visibility="{Binding IsPlusVersion, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="Proxy URL" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,0,0,4"/>
                                    <ui:TextBox Text="{Binding AppSettings.ProxyUrl, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="e.g. socks5://127.0.0.1:1080"/>
                                    <TextBlock Text="Leave empty for direct connection." Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12" Margin="0,4,0,0"/>
                                </StackPanel>
                            </StackPanel>

                            <!-- Advanced (Candy Plus only) -->
                            <StackPanel>
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedSettingsCategory}" Value="Advanced">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <StackPanel Margin="0,0,0,16">
                                    <TextBlock Text="Cookies File" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,0,0,4"/>
                                    <Grid Margin="0,4,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <ui:TextBox Grid.Column="0" Text="{Binding AppSettings.CookiesFilePath}" IsReadOnly="True" PlaceholderText="No file selected" Margin="0,0,8,0"/>
                                        <Button Grid.Column="1" Command="{Binding BrowseCookiesFileCommand}" Content="Browse" Padding="16,6"/>
                                    </Grid>
                                    <TextBlock Text="Used when 'Use Cookies' is toggled on the download page." Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                                <Grid Margin="0,0,0,16">
                                    <TextBlock Text="Enable Argument Injection" Foreground="{DynamicResource TextFillColorPrimaryBrush}" VerticalAlignment="Center"/>
                                    <ui:ToggleSwitch IsChecked="{Binding AppSettings.EnableArgumentInjection}" HorizontalAlignment="Right"/>
                                </Grid>
                                <TextBlock Text="When enabled, a text field appears on the Manual download page where you can type raw yt-dlp arguments." Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12" Margin="0,0,0,16" TextWrapping="Wrap"/>
                            </StackPanel>
                            <!-- About -->
                            <StackPanel>
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedSettingsCategory}" Value="About">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <StackPanel Margin="0,0,0,24">
                                    <TextBlock FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,0,0,4">
                                        <Run Text="{Binding AppName, Mode=OneWay}"/>
                                    </TextBlock>
                                    <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,16">
                                        <Run Text="Version: "/>
                                        <Run Text="{Binding AppVersion, Mode=OneWay}"/>
                                    </TextBlock>
                                    
                                    <TextBlock Text="{Binding AppDescription, Mode=OneWay}" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,0,0,24" MaxWidth="400" HorizontalAlignment="Left">
                                    </TextBlock>
                                    
                                    <TextBlock Text="Built with C#, .NET 8, and yt-dlp" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,24"/>
                                    
                                    <TextBlock Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,0,0,8">
                                        <Run Text="© Chetan Bansode"/>
                                    </TextBlock>
                                    
                                    <StackPanel Orientation="Horizontal" Margin="0,48,0,0">
                                        <TextBlock Foreground="{DynamicResource TextFillColorPrimaryBrush}" VerticalAlignment="Center">
                                            <Run Text="GitHub: "/>
                                        </TextBlock>
                                        <Button Command="{Binding OpenUrlCommand}" CommandParameter="https://github.com/chetanbansode" Background="Transparent" BorderThickness="0" Padding="4" ToolTip="Open GitHub Profile">
                                            <StackPanel Orientation="Horizontal">
                                                <!-- Simple GitHub Icon (SVG Path) -->
                                                <Path Data="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z" Fill="{DynamicResource TextFillColorPrimaryBrush}" Width="16" Height="16" Stretch="Uniform"/>
                                                <TextBlock Text="chetanbansode" Margin="6,0,0,0" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </ScrollViewer>
                </Grid>
            </Grid>

        </Grid>
    </Grid>
</ui:FluentWindow>

